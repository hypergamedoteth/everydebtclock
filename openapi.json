{
 "openapi": "3.0.3",
 "info": {
  "title": "Every Debt Clock feeds",
  "version": "1.0.0",
  "description": "Static JSON and text feeds published by Every Debt Clock (everydebtclock.com). The site is a static build. These URLs are files, not a query API. Free. No API key and no account. Source: Every Debt Clock (everydebtclock.com), from U.S. Treasury Debt to the Penny. State, country, world, and wealth rows name their own official source in the payload. Null means that input was not available. Do not treat a null as zero.",
  "contact": {
   "email": "hello@everydebtclock.com",
   "url": "https://everydebtclock.com/contact/"
  },
  "license": {
   "name": "Free to use with attribution",
   "url": "https://everydebtclock.com/terms/"
  },
  "x-attribution": "Source: Every Debt Clock (everydebtclock.com), from U.S. Treasury Debt to the Penny."
 },
 "servers": [
  {
   "url": "https://everydebtclock.com"
  }
 ],
 "paths": {
  "/api/daily.json": {
   "get": {
    "operationId": "daily",
    "summary": "Latest official US total, changes, and debt-limit fields.",
    "responses": {
     "200": {
      "description": "Latest official US total, changes, and debt-limit fields.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Daily"
        }
       }
      }
     }
    }
   }
  },
  "/api/daily.txt": {
   "get": {
    "operationId": "dailytext",
    "summary": "The same US total as one plain-English line.",
    "responses": {
     "200": {
      "description": "The same US total as one plain-English line.",
      "content": {
       "text/plain": {
        "schema": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  },
  "/api/places.json": {
   "get": {
    "operationId": "places",
    "summary": "State and country clocks.",
    "responses": {
     "200": {
      "description": "State and country clocks.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Places"
        }
       }
      }
     }
    }
   }
  },
  "/api/search.json": {
   "get": {
    "operationId": "search",
    "summary": "Names for the on-site search box.",
    "responses": {
     "200": {
      "description": "Names for the on-site search box.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Search"
        }
       }
      }
     }
    }
   }
  },
  "/api/world.json": {
   "get": {
    "operationId": "world",
    "summary": "World Debt Clock rows, with source tier and as-of date.",
    "responses": {
     "200": {
      "description": "World Debt Clock rows, with source tier and as-of date.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/World"
        }
       }
      }
     }
    }
   }
  },
  "/api/world_government_debt.json": {
   "get": {
    "operationId": "worldgovernment",
    "summary": "IMF general-government estimate for the same economies.",
    "responses": {
     "200": {
      "description": "IMF general-government estimate for the same economies.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/WorldGovernment"
        }
       }
      }
     }
    }
   }
  },
  "/api/wealth.json": {
   "get": {
    "operationId": "wealth",
    "summary": "Sovereign wealth fund ranking.",
    "responses": {
     "200": {
      "description": "Sovereign wealth fund ranking.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Wealth"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "Daily": {
    "type": "object",
    "required": [
     "schema_version",
     "site_url"
    ],
    "properties": {
     "schema_version": {
      "type": "integer",
      "enum": [
       2
      ]
     },
     "as_of": {
      "type": "string",
      "description": "Page build time, America/Chicago offset."
     },
     "fetched_at": {
      "type": "string",
      "nullable": true,
      "description": "When the Treasury rows were pulled, America/Chicago offset."
     },
     "treasury_record_date": {
      "type": "string",
      "format": "date",
      "nullable": true
     },
     "total_debt_official": {
      "type": "number",
      "nullable": true
     },
     "total_debt_projected_now": {
      "type": "number",
      "nullable": true
     },
     "change_1d_official": {
      "type": "object",
      "nullable": true,
      "properties": {
       "amount": {
        "type": "number"
       },
       "from_date": {
        "type": "string",
        "format": "date"
       },
       "from_value": {
        "type": "number"
       }
      }
     },
     "change_7d_official": {
      "type": "object",
      "nullable": true,
      "properties": {
       "amount": {
        "type": "number"
       },
       "from_date": {
        "type": "string",
        "format": "date"
       },
       "from_value": {
        "type": "number"
       }
      }
     },
     "change_30d_official": {
      "type": "object",
      "nullable": true,
      "properties": {
       "amount": {
        "type": "number"
       },
       "from_date": {
        "type": "string",
        "format": "date"
       },
       "from_value": {
        "type": "number"
       }
      }
     },
     "avg_daily_change_90d": {
      "type": "object",
      "nullable": true,
      "properties": {
       "amount_per_day": {
        "type": "number"
       },
       "from_date": {
        "type": "string"
       },
       "to_date": {
        "type": "string"
       },
       "method": {
        "type": "string"
       }
      }
     },
     "per_second_rate": {
      "type": "number",
      "nullable": true
     },
     "held_at_debt_limit": {
      "type": "boolean"
     },
     "per_second_rate_method": {
      "type": "string",
      "nullable": true
     },
     "clock_daily_change_90d": {
      "type": "object",
      "nullable": true,
      "properties": {
       "amount_per_day": {
        "type": "number"
       },
       "per_second": {
        "type": "number"
       },
       "from_date": {
        "type": "string",
        "nullable": true
       },
       "to_date": {
        "type": "string",
        "nullable": true
       },
       "method": {
        "type": "string"
       }
      }
     },
     "debt_per_person_official": {
      "type": "number",
      "nullable": true
     },
     "census_population_official": {
      "type": "integer",
      "nullable": true
     },
     "census_population_vintage": {
      "type": "string",
      "nullable": true
     },
     "census_population_date": {
      "type": "string",
      "format": "date",
      "nullable": true
     },
     "debt_per_person_projected_now": {
      "type": "number",
      "nullable": true
     },
     "population_projected_now": {
      "type": "number",
      "nullable": true
     },
     "debt_per_household_official": {
      "type": "number",
      "nullable": true
     },
     "debt_per_household_projected_now": {
      "type": "number",
      "nullable": true
     },
     "households_official": {
      "type": "integer",
      "nullable": true
     },
     "households_source": {
      "type": "string",
      "nullable": true
     },
     "per_person_basis": {
      "type": "string"
     },
     "displayed_per_person": {
      "type": "string",
      "description": "Which per-person field the site displays. Currently debt_per_person_official."
     },
     "displayed_per_person_note": {
      "type": "string"
     },
     "stale": {
      "type": "boolean"
     },
     "source_url": {
      "type": "string"
     },
     "source_api": {
      "type": "string"
     },
     "site_url": {
      "type": "string"
     },
     "debt_subject_to_limit": {
      "type": "number",
      "nullable": true
     },
     "statutory_limit": {
      "type": "number",
      "nullable": true,
      "description": "Null unless debt_limit_reported_status is in_force."
     },
     "dts_record_date": {
      "type": "string",
      "format": "date",
      "nullable": true
     },
     "debt_limit_headroom": {
      "type": "number",
      "nullable": true
     },
     "debt_limit_reported_status": {
      "type": "string",
      "nullable": true,
      "description": "in_force, suspended, unreported, or ambiguous. Null when Table III-C is not in the build."
     },
     "days_to_limit_estimate": {
      "type": "object",
      "nullable": true,
      "description": "Estimate, not a Treasury forecast and not an X-date. Null unless the limit status is in_force and the 90-day slope is positive.",
      "properties": {
       "days": {
        "type": "number"
       },
       "projected_date": {
        "type": "string",
        "format": "date"
       },
       "per_day": {
        "type": "number"
       },
       "from_date": {
        "type": "string",
        "format": "date"
       },
       "method": {
        "type": "string"
       }
      }
     },
     "extraordinary_measures": {
      "type": "string",
      "nullable": true,
      "description": "Label recorded from Treasury's debt-limit page. Absent or null means the feed does not say."
     }
    }
   },
   "Place": {
    "type": "object",
    "properties": {
     "slug": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "kind": {
      "type": "string",
      "enum": [
       "state",
       "country"
      ]
     },
     "country": {
      "type": "string",
      "nullable": true
     },
     "region_code": {
      "type": "string",
      "nullable": true
     },
     "demonym": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "currency": {
      "type": "string"
     },
     "sym": {
      "type": "string"
     },
     "frequency": {
      "type": "string"
     },
     "base": {
      "type": "number"
     },
     "base_date": {
      "type": "string"
     },
     "t0": {
      "type": "number"
     },
     "rate": {
      "type": "number",
      "description": "Per second. Zero means the official figure is not projected."
     },
     "population": {
      "type": "number"
     },
     "publisher": {
      "type": "string"
     },
     "url": {
      "type": "string",
      "description": "Path relative to the site root."
     }
    }
   },
   "SearchHit": {
    "type": "object",
    "properties": {
     "n": {
      "type": "string",
