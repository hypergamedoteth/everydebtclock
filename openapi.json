      "type": "number"
     },
     "fx_date": {
      "type": "string"
     },
     "fx_source": {
      "type": "string"
     },
     "debt_usd": {
      "type": "number"
     },
     "debt_to_gdp": {
      "type": "number",
      "nullable": true
     },
     "share_pct": {
      "type": "number"
     },
     "population": {
      "type": "number",
      "nullable": true
     },
     "trend_usd_per_sec": {
      "type": "number"
     },
     "trend": {
      "type": "string",
      "nullable": true
     },
     "projected_usd": {
      "type": "number"
     },
     "below_anchor_reason": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "source_url": {
      "type": "string"
     },
     "imf_debt_2026_usd": {
      "type": "number",
      "nullable": true
     },
     "url": {
      "type": "string"
     }
    }
   },
   "WealthFund": {
    "type": "object",
