     },
     "u": {
      "type": "string",
      "description": "URL relative to the site root."
     },
     "k": {
      "type": "string"
     },
     "a": {
      "type": "string",
      "description": "Extra search words."
     }
    }
   },
   "WorldCountry": {
    "type": "object",
    "properties": {
     "slug": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "iso3": {
      "type": "string"
     },
     "tier": {
      "type": "string",
      "enum": [
       "official",
       "harmonized",
       "imf"
