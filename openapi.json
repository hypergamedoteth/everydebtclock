     },
     "default": {
      "type": "string"
     },
     "hub": {
      "type": "string"
     },
     "hub_label": {
      "type": "string"
     },
     "places": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Place"
      }
     }
    }
   },
   "Search": {
    "type": "object",
